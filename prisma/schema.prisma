generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum MeetingStatus {
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

enum ParticipantRole {
  HOST
  MODERATOR
  PARTICIPANT
}

enum AdmissionStatus {
  WAITING
  ADMITTED
  REJECTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum RecordingStatus {
  STARTING
  ACTIVE
  ENDING
  COMPLETE
  FAILED
  ABORTED
}

enum PlanCode {
  FREE
  PRO
}

enum PaymentProvider {
  MIDTRANS
  IPAYMU
  FLIP
}

enum PaymentOrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum InviteChannel {
  EMAIL
  WHATSAPP
}

enum ReminderKind {
  INVITE
  T_MINUS_24H
  T_MINUS_1H
}

enum PlanReminderKind {
  T_MINUS_7D
  T_MINUS_3D
  T_MINUS_1D
  EXPIRED
}

model User {
  id                String                   @id @default(uuid()) @db.Char(36)
  name              String                   @db.VarChar(80)
  email             String                   @unique @db.VarChar(255)
  passwordHash      String?                  @map("password_hash") @db.VarChar(255)
  googleSub         String?                  @unique @map("google_sub") @db.VarChar(255)
  emailVerifiedAt   DateTime?                @map("email_verified_at")
  isSuperAdmin      Boolean                  @default(false) @map("is_super_admin")
  isDisabled        Boolean                  @default(false) @map("is_disabled")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  memberships       OrganizationMember[]
  sessions          Session[]
  authTokens        AuthToken[]
  meetings          Meeting[]                @relation("MeetingCreator")
  participations    MeetingParticipant[]
  invitationsSent   OrganizationInvitation[] @relation("InvitationInviter")
  auditLogs         AuditLog[]               @relation("AuditActor")
  recordingsStarted Recording[]              @relation("RecordingStarter")
  recordingsConsented Recording[]            @relation("RecordingConsent")
  paymentOrders     PaymentOrder[]           @relation("PaymentOrderCreator")

  @@map("users")
}

model AuthToken {
  id         String        @id @default(uuid()) @db.Char(36)
  userId     String        @map("user_id") @db.Char(36)
  type       AuthTokenType
  tokenHash  String        @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime      @map("expires_at")
  consumedAt DateTime?     @map("consumed_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model Session {
  id                   String        @id @default(uuid()) @db.Char(36)
  tokenHash            String        @unique @map("token_hash") @db.Char(64)
  userId               String        @map("user_id") @db.Char(36)
  activeOrganizationId String?       @map("active_organization_id") @db.Char(36)
  expiresAt            DateTime      @map("expires_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization   Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@index([activeOrganizationId])
  @@map("sessions")
}

model Organization {
  id                     String                   @id @default(uuid()) @db.Char(36)
  name                   String                   @db.VarChar(100)
  slug                   String                   @unique @db.VarChar(120)
  brandName              String?                  @map("brand_name") @db.VarChar(100)
  logoUrl                String?                  @map("logo_url") @db.VarChar(1000)
  primaryColor           String?                  @map("primary_color") @db.VarChar(20)
  customDomain           String?                  @unique @map("custom_domain") @db.VarChar(255)
  ssoEnabled             Boolean                  @default(false) @map("sso_enabled")
  ssoProvider            String?                  @map("sso_provider") @db.VarChar(40)
  ssoClientId            String?                  @map("sso_client_id") @db.VarChar(255)
  ssoTenantHint          String?                  @map("sso_tenant_hint") @db.VarChar(255)
  planCode               PlanCode                 @default(FREE) @map("plan_code")
  planExpiresAt          DateTime?                @map("plan_expires_at")
  recordingRetentionDays Int?                     @map("recording_retention_days")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  memberships            OrganizationMember[]
  meetings               Meeting[]
  invitations            OrganizationInvitation[]
  auditLogs              AuditLog[]
  sessions               Session[]
  recordings             Recording[]
  paymentOrders          PaymentOrder[]
  planReminderLogs       PlanReminderLog[]

  @@map("organizations")
}

model OrganizationInvitation {
  id             String           @id @default(uuid()) @db.Char(36)
  organizationId String           @map("organization_id") @db.Char(36)
  email          String           @db.VarChar(255)
  role           OrganizationRole @default(MEMBER)
  tokenHash      String           @unique @map("token_hash") @db.Char(64)
  status         InvitationStatus @default(PENDING)
  invitedById    String           @map("invited_by_id") @db.Char(36)
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User             @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([email, status])
  @@map("organization_invitations")
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  actorId        String?      @map("actor_id") @db.Char(36)
  action         String       @db.VarChar(80)
  targetType     String       @map("target_type") @db.VarChar(80)
  targetId       String?      @map("target_id") @db.VarChar(120)
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Char(36)
  organizationId String           @map("organization_id") @db.Char(36)
  userId         String           @map("user_id") @db.Char(36)
  role           OrganizationRole @default(MEMBER)
  joinedAt       DateTime         @default(now()) @map("joined_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Meeting {
  id              String               @id @default(uuid()) @db.Char(36)
  organizationId  String               @map("organization_id") @db.Char(36)
  createdById     String               @map("created_by_id") @db.Char(36)
  title           String               @db.VarChar(120)
  roomName        String               @unique @map("room_name") @db.VarChar(64)
  passwordHash    String?              @map("password_hash") @db.VarChar(255)
  waitingRoom     Boolean              @default(true) @map("waiting_room")
  status          MeetingStatus        @default(SCHEDULED)
  startsAt        DateTime?            @map("starts_at")
  actualStartedAt DateTime?            @map("actual_started_at")
  endedAt         DateTime?            @map("ended_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User                 @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  participants    MeetingParticipant[]
  recordings      Recording[]
  invites         MeetingInvite[]
  reminders       ReminderSent[]

  @@index([organizationId, startsAt])
  @@index([createdById])
  @@map("meetings")
}

model MeetingInvite {
  id         String        @id @default(uuid()) @db.Char(36)
  meetingId  String        @map("meeting_id") @db.Char(36)
  channel    InviteChannel
  recipient  String        @db.VarChar(255)
  email      String?       @db.VarChar(255)
  phoneE164  String?       @map("phone_e164") @db.VarChar(20)
  createdAt  DateTime      @default(now()) @map("created_at")
  meeting    Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, channel, recipient])
  @@index([meetingId])
  @@index([phoneE164])
  @@map("meeting_invites")
}

model ReminderSent {
  id          String        @id @default(uuid()) @db.Char(36)
  meetingId   String        @map("meeting_id") @db.Char(36)
  kind        ReminderKind
  channel     InviteChannel
  recipient   String        @db.VarChar(255)
  providerRef String?       @map("provider_ref") @db.VarChar(128)
  status      String        @db.VarChar(32)
  sentAt      DateTime      @default(now()) @map("sent_at")
  meeting     Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, kind, channel, recipient])
  @@index([meetingId, kind])
  @@map("reminder_sent")
}

model Recording {
  id                   String          @id @default(uuid()) @db.Char(36)
  meetingId            String          @map("meeting_id") @db.Char(36)
  organizationId       String          @map("organization_id") @db.Char(36)
  startedById          String?         @map("started_by_id") @db.Char(36)
  consentAcknowledgedAt DateTime?      @map("consent_acknowledged_at")
  consentByUserId      String?         @map("consent_by_user_id") @db.Char(36)
  egressId             String          @unique @map("egress_id") @db.VarChar(128)
  status               RecordingStatus @default(STARTING)
  filepath             String?         @db.VarChar(512)
  downloadUrl          String?         @map("download_url") @db.VarChar(1000)
  durationSeconds      Int?            @map("duration_seconds")
  errorMessage         String?         @map("error_message") @db.VarChar(500)
  startedAt            DateTime        @default(now()) @map("started_at")
  endedAt              DateTime?       @map("ended_at")
  meeting              Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  organization         Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  startedBy            User?           @relation("RecordingStarter", fields: [startedById], references: [id], onDelete: SetNull)
  consentBy            User?           @relation("RecordingConsent", fields: [consentByUserId], references: [id], onDelete: SetNull)

  @@index([meetingId, startedAt])
  @@index([organizationId, startedAt])
  @@index([status])
  @@map("recordings")
}

model PlanReminderLog {
  id             String           @id @default(uuid()) @db.Char(36)
  organizationId String           @map("organization_id") @db.Char(36)
  kind           PlanReminderKind
  periodKey      String           @map("period_key") @db.VarChar(10)
  sentAt         DateTime         @default(now()) @map("sent_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind, periodKey])
  @@index([organizationId, sentAt])
  @@map("plan_reminder_logs")
}

model PaymentOrder {
  id              String             @id @default(uuid()) @db.Char(36)
  organizationId  String             @map("organization_id") @db.Char(36)
  createdById     String             @map("created_by_id") @db.Char(36)
  provider        PaymentProvider
  planCode        PlanCode           @map("plan_code")
  orderId         String             @unique @map("order_id") @db.VarChar(64)
  amountIdr       Int                @map("amount_idr")
  status          PaymentOrderStatus @default(PENDING)
  providerRef     String?            @map("provider_ref") @db.VarChar(191)
  checkoutUrl     String?            @map("checkout_url") @db.VarChar(1000)
  paidAt          DateTime?          @map("paid_at")
  expiresAt       DateTime?          @map("expires_at")
  metadata        Json?
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User               @relation("PaymentOrderCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([status, createdAt])
  @@index([provider, status])
  @@map("payment_orders")
}

model MeetingParticipant {
  id                  String          @id @default(uuid()) @db.Char(36)
  meetingId           String          @map("meeting_id") @db.Char(36)
  userId              String?         @map("user_id") @db.Char(36)
  livekitIdentity     String          @map("livekit_identity") @db.VarChar(128)
  displayName         String          @map("display_name") @db.VarChar(80)
  role                ParticipantRole @default(PARTICIPANT)
  admissionStatus     AdmissionStatus @default(ADMITTED) @map("admission_status")
  admissionTokenHash  String?         @unique @map("admission_token_hash") @db.Char(64)
  admissionExpiresAt  DateTime?       @map("admission_expires_at")
  admissionConsumedAt DateTime?       @map("admission_consumed_at")
  requestedAt         DateTime        @default(now()) @map("requested_at")
  joinedAt            DateTime?       @map("joined_at")
  leftAt              DateTime?       @map("left_at")
  durationSeconds     Int             @default(0) @map("duration_seconds")
  meeting             Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user                User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([meetingId, livekitIdentity])
  @@index([meetingId, joinedAt])
  @@index([userId])
  @@map("meeting_participants")
}

model LiveKitWebhookEvent {
  id          String   @id @default(uuid()) @db.Char(36)
  eventId     String   @unique @map("event_id") @db.VarChar(80)
  eventType   String   @map("event_type") @db.VarChar(80)
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("livekit_webhook_events")
}

model PlatformSettings {
  id                   Int      @id @default(1)
  appName              String   @default("GenMeet") @map("app_name") @db.VarChar(80)
  logoUrl              String?  @map("logo_url") @db.VarChar(1000)
  loginBackgroundUrl   String?  @map("login_background_url") @db.VarChar(1000)
  splashBackgroundUrl  String?  @map("splash_background_url") @db.VarChar(1000)
  splashLogoUrl        String?  @map("splash_logo_url") @db.VarChar(1000)
  supportEmail         String?  @map("support_email") @db.VarChar(255)
  maintenanceMode      Boolean  @default(false) @map("maintenance_mode")
  integrationsCipher   String?  @map("integrations_cipher") @db.LongText
  planCatalog          Json?    @map("plan_catalog")
  updatedAt            DateTime @updatedAt @map("updated_at")
  updatedById          String?  @map("updated_by_id") @db.Char(36)

  @@map("platform_settings")
}
