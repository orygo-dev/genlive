LIVEKIT_URL=wss://your-livekit-host.example.com
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
# Optional explicit HTTPS host for Egress API (defaults from LIVEKIT_URL)
LIVEKIT_API_URL=https://your-livekit-host.example.com
DATABASE_URL=mysql://genmeet:genmeet@localhost:3306/genmeet
SESSION_COOKIE_NAME=genmeet_session
APP_URL=http://localhost:3000
# Email super admin (bisa beberapa, pisahkan koma). Login dengan email ini mendapat akses /admin
SUPER_ADMIN_EMAIL=admin@example.com
RESEND_API_KEY=
EMAIL_FROM="GenMeet <onboarding@resend.dev>"

# WhatsApp gateway (Fonnte) untuk undangan & reminder meeting
FONNTE_TOKEN=
FONNTE_COUNTRY_CODE=62
# Secret untuk melindungi cron reminder (Authorization: Bearer ...)
CRON_SECRET=
# Optional S3 (or S3-compatible) destination for recordings
LIVEKIT_EGRESS_S3_ACCESS_KEY=
LIVEKIT_EGRESS_S3_SECRET=
LIVEKIT_EGRESS_S3_BUCKET=
LIVEKIT_EGRESS_S3_REGION=
# LIVEKIT_EGRESS_S3_ENDPOINT=
# LIVEKIT_EGRESS_S3_FORCE_PATH_STYLE=true

# Billing: pilih gateway default (MIDTRANS | IPAYMU | FLIP)
PAYMENT_PROVIDER=MIDTRANS

# Midtrans Snap
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# iPaymu Redirect Payment
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_IS_PRODUCTION=false

# Flip Business Accept Payment
FLIP_SECRET_KEY=
FLIP_VALIDATION_TOKEN=
FLIP_IS_PRODUCTION=false

# Production notes:
# - DATABASE_URL memakai mysql://USER:PASS@HOST:3306/DB
# - APP_URL harus HTTPS di production
# - Jalankan: npm run check:env -- --strict
# - Healthcheck: GET /api/health
# - Lihat PRODUCTION.md / AAPANEL.md untuk checklist go-live
