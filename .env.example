# Runtime (selalu di .env server — jangan hanya lewat UI)
NODE_ENV=production
PORT=3010
HOSTNAME=0.0.0.0
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/genmeet
# Minimal 32 karakter; dipakai AES-256-GCM untuk secret di Super Admin → Integrasi
APP_ENCRYPTION_KEY=ganti-dengan-string-rahasia-panjang-minimal-32-char

SESSION_COOKIE_NAME=genmeet_session

# Boleh diisi di .env ATAU lewat /admin → Integrasi (DB mengalahkan env jika terisi)
APP_URL=https://meet.domainanda.com
LIVEKIT_URL=wss://xxxx.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional explicit HTTPS host for Egress API (defaults from LIVEKIT_URL)
LIVEKIT_API_URL=

RESEND_API_KEY=
EMAIL_FROM="GenMeet <onboarding@resend.dev>"

# WhatsApp gateway (Fonnte) untuk undangan & reminder meeting
FONNTE_TOKEN=
FONNTE_COUNTRY_CODE=62
# Secret untuk melindungi cron reminder (Authorization: Bearer ...)
CRON_SECRET=

# Optional S3 (or S3-compatible) destination for recordings
LIVEKIT_EGRESS_S3_ACCESS_KEY=
LIVEKIT_EGRESS_S3_SECRET=
LIVEKIT_EGRESS_S3_BUCKET=
LIVEKIT_EGRESS_S3_REGION=
# LIVEKIT_EGRESS_S3_ENDPOINT=
# LIVEKIT_EGRESS_S3_FORCE_PATH_STYLE=true

# Billing: pilih gateway default (MIDTRANS | IPAYMU | FLIP)
PAYMENT_PROVIDER=MIDTRANS

# Midtrans Snap
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# iPaymu Redirect Payment
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_IS_PRODUCTION=false

# Flip Business Accept Payment
FLIP_SECRET_KEY=
FLIP_VALIDATION_TOKEN=
FLIP_IS_PRODUCTION=false

# Super Admin (email yang otomatis dapat akses /admin)
# SUPER_ADMIN_EMAIL=anda@perusahaan.com

# Production notes:
# - DATABASE_URL + APP_ENCRYPTION_KEY wajib di file env server
# - Integrasi LiveKit/email/WA/payment bisa diisi dari /admin → Integrasi
# - Jalankan: npm run check:env -- --strict
# - Healthcheck: GET /api/health
# - Lihat PRODUCTION.md / AAPANEL.md untuk checklist go-live
