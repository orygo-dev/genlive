{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm ci",
  "crons": [
    {
      "path": "/api/cron/meeting-reminders",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/plan-reminders",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/recording-retention",
      "schedule": "0 3 * * *"
    }
  ]
}
